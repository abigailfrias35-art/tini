{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/admin",
      "dest": "/admin.html"
    },
    {
      "src": "/panel_usuario",
      "dest": "/panel_usuario.html"
    },
    {
      "src": "/proyecto",
      "dest": "/proyecto.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
